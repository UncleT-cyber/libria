# Libria env - copy to .env (local) and set in Vercel + Render dashboards
# See: Vercel Settings -> Environment Variables, Render Dashboard -> Environment

# Supabase (run supabase/schema.sql in Supabase SQL Editor first)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
SUPABASE_ANON_KEY=eyJ...anon...
# Vercel exposes to Vite as VITE_*
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon...
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# Spotify OAuth (libria/spotify.py + api/auth)
SPOTIFY_CLIENT_ID=xxx
SPOTIFY_CLIENT_SECRET=xxx
# Redirect must match Spotify Dashboard exactly:
# local: http://127.0.0.1:5173/callback
# vercel prod: https://your-app.vercel.app/callback
SPOTIFY_REDIRECT_URI=https://your-app.vercel.app/callback

# Deployment wiring - Vercel frontend -> Render backend
# Set in Vercel: VITE_API_URL=https://libria-api.onrender.com/api
VITE_API_URL=https://libria-api.onrender.com/api
# Render backend port is auto-injected as PORT=10000 (server.py reads it)

# Optional: local SQLite fallback path (when SUPABASE_URL not set, e.g. Tauri desktop)
LIBRIA_DB_PATH=./libria.db
